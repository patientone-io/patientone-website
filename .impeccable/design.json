    {
      "name": "Language control",
      "kind": "button",
      "refersTo": "language-button",
      "description": "Transparent PL/EN controls with an underlined selected state; static preview shows PL selected.",
      "html": "<div class=\"ds-language\" role=\"group\" aria-label=\"Language\"><button type=\"button\" aria-pressed=\"true\">PL</button><span aria-hidden=\"true\">/</span><button type=\"button\" aria-pressed=\"false\">EN</button></div>",
      "css": ".ds-language{display:flex;align-items:center;gap:.6rem;padding-left:1.5rem;border-left:1px solid #657071;color:var(--secondary);font-family:\"Geist\",system-ui,sans-serif;}.ds-language button{font-family:\"Geist\",system-ui,sans-serif;font-size:1.125rem;line-height:1.5;min-width:32px;min-height:44px;padding:.2rem 0;border:0;color:var(--secondary);background:transparent;position:relative;cursor:pointer}.ds-language button::after{content:\"\";position:absolute;bottom:.2rem;inset-inline:0;height:1px;background:transparent}.ds-language button:hover{color:var(--accent-hover)}.ds-language button[aria-pressed=\"true\"]{color:var(--accent)}.ds-language button[aria-pressed=\"true\"]::after{background:currentColor}.ds-language button:focus-visible{outline:2px solid var(--accent);outline-offset:5px;border-radius:2px;}@media(max-width:600px){.ds-language{padding-left:.8rem;gap:.25rem}.ds-language button{font-size:1rem;min-width:28px}}"
    },
    {
      "name": "Project row",
      "kind": "button",
      "refersTo": "project-row",
      "description": "One native link for the entire project row; title, description and action share one destination and one keyboard stop.",
      "html": "<a class=\"ds-project\" href=\"https://github.com/patientone-io/opusbook\" aria-labelledby=\"ds-opusbook-title\"><div><h3 id=\"ds-opusbook-title\">opusbook</h3><p>Convert audiobooks and podcasts to Opus.</p></div><span aria-hidden=\"true\">View on GitHub</span></a>",
      "css": ".ds-project{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1.5rem;padding:.75rem 0;min-height:7.25rem;color:var(--text);font-family:\"Geist\",system-ui,sans-serif;text-decoration:none}.ds-project h3{margin:0;font-size:1.625rem;font-weight:600;letter-spacing:-.02em}.ds-project p{margin:.1rem 0 0;font-size:1.125rem;color:var(--secondary)}.ds-project>span{color:var(--accent);font-size:1rem}.ds-project:hover h3,.ds-project:focus-visible h3{color:var(--accent-hover);text-decoration:underline;text-underline-offset:.2em}.ds-project:focus-visible{outline:2px solid var(--accent);outline-offset:5px}@media(max-width:600px){.ds-project{grid-template-columns:1fr}.ds-project h3{font-size:1.375rem}.ds-project p{font-size:1rem}}"
    },
    {
      "name": "Technology tag",
      "kind": "chip",
      "refersTo": "technology-tag",
      "description": "A passive technology label, without action or hover states.",
      "html": "<span class=\"ds-tag\">Python</span>",
      "css": ".ds-tag{font-family:\"Geist\",system-ui,sans-serif;display:inline-block;color:var(--secondary);background:var(--tag-background);border-radius:var(--radius);padding:.12rem .6rem;font-size:.875rem;line-height:1.5}@media(max-width:600px){.ds-tag{font-size:.8125rem;padding:.15rem .5rem}}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
      "refersTo": "header-navigation",
      "description": "Shared home link with circular avatar and wordmark, paired with GitHub navigation.",
      "html": "<nav class=\"ds-header\" aria-label=\"Main\"><a class=\"ds-wordmark\" href=\"./\"><img class=\"ds-avatar\" src=\"avatar.png\" width=\"36\" height=\"36\" alt=\"\">patientone</a><a class=\"ds-header-link\" href=\"https://github.com/patientone-io\">GitHub</a></nav>",
      "css": ".ds-header{font-family:\"Geist\",system-ui,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:4.75rem;color:var(--text)}.ds-header a{text-decoration:none}.ds-wordmark{display:inline-flex;align-items:center;gap:.625rem;font-size:1.625rem;font-weight:600;letter-spacing:-.025em;line-height:1.5}.ds-header-link{display:inline-flex;align-items:center;min-height:44px;font-size:1.125rem;line-height:1.5;white-space:nowrap}.ds-header a:hover{color:var(--accent-hover)}.ds-header a:focus-visible{outline:2px solid var(--accent);outline-offset:5px;border-radius:2px;}@media(max-width:600px){.ds-header{min-height:5rem;flex-wrap:wrap;padding-block:.6rem;gap:.2rem .8rem}.ds-wordmark{display:inline-flex;align-items:center;gap:.625rem;font-size:1.375rem}.ds-header-link{font-size:1rem}}.ds-avatar{width:36px;height:36px;border-radius:50%;flex-shrink:0}@media(max-width:600px){.ds-avatar{width:32px;height:32px}.ds-wordmark{gap:.5rem}}"
    },
