  "narrative": {
    "northStar": "Personal Tool Collection",
    "overview": "A continuous graphite ground, warm white humanist type and mineral mint links give this personal collection a calm, direct presence. Moderately scaled introductory type establishes the voice; compact project rows make the work easy to scan.\n\nThe same typography, header and footer continue into narrower legal documents. Hierarchy comes from type, spacing and thin separators. Interaction stays quiet: a selected-language underline, visible keyboard focus and a small repository-arrow response.",
    "keyCharacteristics": [
      "One continuous dark ground with a single mint accent.",
      "Large humanist introduction and compact, separated project rows.",
      "Shared typography and navigation across portfolio and legal pages.",
      "Responsive text flow and direct repository and contact links."
    ],
    "rules": [
      {
        "name": "Continuous Ground",
        "body": "Keep the page and project rows on the background color; use separators and spacing to distinguish rows.",
        "section": "colors"
      },
      {
        "name": "Shared Voice",
        "body": "Use Geist for display, body and controls; reserve the system monospace stack for inline code.",
        "section": "typography"
      },
      {
        "name": "Flat Surface",
        "body": "Use no shadows or gradients; hierarchy comes from type, spacing, dividers and the darker tag surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the shared dark palette and Geist typography on legal pages.",
      "Do keep project descriptions, technology tags and repository actions visually associated as the layout narrows.",
      "Do preserve the mint selected-language underline and visible keyboard focus.",
      "Do let Polish and English copy wrap without clipping or fixed text heights.",
      "Do use compact inline SVG geometry with currentColor for project and action icons.",
      "Do make each complete project row one native link, with one keyboard stop and a clear title hover/focus state."
    ],
    "donts": [
      "Don't turn the flat project rows into raised cards or introduce shadows.",
      "Don't style passive technology tags as buttons or filters.",
      "Don't rely on the arrow movement alone to identify a repository action.",
      "Don't replace the shared legal reading column with the portfolio's wide row layout."
    ]
  }
}
