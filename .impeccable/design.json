      "html": "<section class=\"ds-contact\"><svg class=\"ds-envelope\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"1\"/><path d=\"m3 5 9 8 9-8\"/></svg><div><h2>Contact</h2><a href=\"mailto:contact@patientone.uk\">contact@patientone.uk</a></div></section>",
      "css": ".ds-contact{font-family:\"Geist\",system-ui,sans-serif;display:flex;align-items:center;gap:2.25rem;min-width:0;color:var(--text);line-height:1.5}.ds-envelope{width:2.75rem;height:2.75rem;flex-shrink:0}.ds-contact h2{margin:0;font-size:1.125rem;font-weight:500;line-height:1.2}.ds-contact a{color:var(--accent);font-size:1.125rem;overflow-wrap:anywhere;text-decoration:none;text-underline-offset:.25em}.ds-contact a:hover{color:var(--accent-hover);text-decoration:underline}.ds-contact a:focus-visible{outline:2px solid var(--accent);outline-offset:5px;border-radius:2px;}@media(max-width:600px){.ds-contact{gap:1rem}.ds-envelope{width:2.25rem;height:2.25rem}.ds-contact h2,.ds-contact a{font-size:1.0625rem}}"
